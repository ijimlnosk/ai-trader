NODE_ENV=development
HOST=0.0.0.0
PORT=3000
POSTGRES_DB=ai_trader
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=
DATABASE_URL=
BROKER_MODE=paper
LIVE_TRADING_ENABLED=false
PAPER_ORDER_EXECUTION_ENABLED=false
PAPER_LOOP_ENABLED=false
# Order-free daily KIS bar collection after 18:30 KST.
MARKET_DATA_SCHEDULE_ENABLED=false
# Automatic daily tick; requires PAPER_LOOP_ENABLED and PAPER_ORDER_EXECUTION_ENABLED, no task file.
PAPER_LOOP_SCHEDULE_ENABLED=false
# Order-free daily news archive for the universe (NAVER API Hub news, NCP application key pair). Caps are self-imposed and far
# below the provider limit (25,000/day, 775,000/month); code rejects values above 20,000 / 600,000.
NEWS_SCHEDULE_ENABLED=false
# Order-free daily evaluation of the whole universe, stored as plan-* strategy runs.
UNIVERSE_PLAN_SCHEDULE_ENABLED=false
# Paper-execute the daily momentum plan; requires paper execution + plan schedule, excludes the EMA loop schedule.
MOMENTUM_EXECUTION_ENABLED=false
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_DAILY_CALL_CAP=1000
NAVER_MONTHLY_CALL_CAP=20000
# Optional fixed local task file inside the server; omit for manual ticks only.
# PAPER_LOOP_TASK_FILE=/app/paper-loop-task.json
# Required (32+ random characters) when enabling paper order APIs; never expose to a browser bundle.
ORDER_API_TOKEN=
# Operator read token (32+ chars, different from ORDER_API_TOKEN); never given to the web server.
CONSOLE_READ_TOKEN=
TRADING_KILL_SWITCH_ENABLED=false
# Existing Docker volume name, required by Compose; never guess this value.
POSTGRES_VOLUME_NAME=

# KIS paper credentials only. Account fields are required for portfolio queries.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
# Account number: exactly 8 digits (no hyphen or product suffix).
KIS_ACCOUNT_NO=
# Product code: exactly 2 digits; preserve leading zero.
KIS_ACCOUNT_PRODUCT_CODE=

# Web BFF only. Production Compose uses the deployed HTTPS origin by default.
CONSOLE_API_URL=http://127.0.0.1:3000
CONSOLE_PUBLIC_ORIGIN=http://localhost:3100
