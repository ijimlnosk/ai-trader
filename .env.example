NODE_ENV=development
HOST=0.0.0.0
PORT=3000
POSTGRES_DB=ai_trader
POSTGRES_USER=ai_trader
POSTGRES_PASSWORD=
DATABASE_URL=
BROKER_MODE=paper
LIVE_TRADING_ENABLED=false
# Existing Docker volume name, required by Compose; never guess this value.
POSTGRES_VOLUME_NAME=

# KIS paper credentials only. Accounts are reserved configuration, unused by quotes.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_BASE_URL=https://openapivts.koreainvestment.com:29443
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
